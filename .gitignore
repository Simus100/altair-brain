.env
*.key
**/secrets.*
graphify-out/cache/
# Indice semantico: grande e ricostruibile (tools/build_dense_index.py).
# L'indice lessicale BM25 (engine/search_index.json) invece STA in git: e piccolo,
# deterministico e serve ai consumatori senza dipendenze.
graphify-out/search/
__pycache__/
*.pyc
.pytest_cache/

# Dati pesanti delle macroaree: restano su disco locale, NON in git
# (limiti GitHub 100MB/file; la VPS clona il repo a ogni update). La conoscenza
# vive negli appunti .txt/.md/.docx e nelle pagine wiki; i dati sono documentati.
raw/**/*.xlsx
raw/**/*.pbix
raw/**/*.csv
raw/**/*.zip
raw/**/*.png
raw/**/*.pdf
raw/**/*.bkp
**/~$*
raw/**/backup/
raw/**/excell_old/
test_env/

# Hook eseguibili: attivi in locale, MAI versionati (repo pubblico).
.claude/settings.local.json
.claude/settings.json

# Windows: file di sistema delle cartelle, nessuna informazione
desktop.ini
